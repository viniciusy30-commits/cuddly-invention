        </GridLayout>

        <FrameLayout
            android:id="@+id/fullscreen_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pane_background"
            android:elevation="12dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/fullscreen_exit_overlay"
            style="@style/FullscreenOverlayExit"
            android:layout_gravity="top|end"
            android:contentDescription="@string/fullscreen_exit"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

        <TextView
            android:id="@+id/profile_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pane_background"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/multi_profile_unavailable"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
