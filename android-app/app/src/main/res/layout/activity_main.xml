<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/app_toolbar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_app_toolbar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_title"
                style="@style/AppTitle"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/app_subtitle"
                style="@style/AppSubtitle"
                android:layout_marginTop="2dp"
                android:text="@string/app_subtitle" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/theme_toggle"
            style="@style/ThemeButton"
            android:contentDescription="@string/theme_switch_to_dark"
            android:src="@drawable/ic_moon" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/grid_background"
        android:padding="3dp">

        <GridLayout
            android:id="@+id/browser_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grid_background"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

        <LinearLayout
            android:id="@+id/pane_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pane_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pane_toolbar_1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_pane_toolbar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/PaneBadge"
                    android:text="01" />

                <EditText
                    android:id="@+id/address_1"
                    style="@style/AddressBar"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/go_1"
                    style="@style/ActionButton"
                    android:text="@string/go" />

                <ImageButton
                    android:id="@+id/reload_1"
                    style="@style/IconButton"
                    android:contentDescription="@string/reload"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/fullscreen_1"
                    style="@style/IconButton"
                    android:contentDescription="@string/fullscreen_enter"
                    android:src="@drawable/ic_expand" />

                <ImageButton
                    android:id="@+id/close_1"
                    style="@style/DangerIconButton"
                    android:contentDescription="@string/close_instance"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
                    android:id="@+id/webview_1"
                    style="@style/BrowserWebView"
                    android:contentDescription="@string/webview_description_1" />

                <LinearLayout
                    android:id="@+id/empty_state_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pane_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/EmptyTitle"
                        android:text="@string/instance_closed" />

                    <TextView
                        style="@style/EmptyDetail"
                        android:text="@string/instance_closed_detail" />

                    <Button
                        android:id="@+id/reopen_1"
                        style="@style/ReopenButton"
                        android:text="@string/reopen_instance" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/pane_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pane_card"
