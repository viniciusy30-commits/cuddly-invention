                            android:text="@string/ready_to_browse" />

                        <TextView
                            android:id="@+id/pane_subtitle_2"
                            style="@style/PaneSubtitle"
                            android:text="Instância 2 • em execução" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/navigate_2"
                        style="@style/IconButton"
                        android:contentDescription="@string/navigate"
                        android:src="@drawable/ic_navigate" />

                    <ImageButton
                        android:id="@+id/reload_2"
                        style="@style/IconButton"
                        android:contentDescription="@string/reload"
                        android:src="@drawable/ic_refresh" />

                    <ImageButton
                        android:id="@+id/fullscreen_2"
                        style="@style/IconButton"
                        android:contentDescription="@string/fullscreen_enter"
                        android:src="@drawable/ic_expand" />

                    <ImageButton
                        android:id="@+id/auto_click_2"
                        style="@style/IconButton"
                        android:contentDescription="@string/open_auto_clicker"
                        android:src="@drawable/ic_auto_click" />

                    <ImageButton
                        android:id="@+id/close_2"
                        style="@style/DangerIconButton"
                        android:contentDescription="@string/close_instance"
                        android:src="@drawable/ic_close" />
                </LinearLayout>
