                        android:src="@drawable/ic_close" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
