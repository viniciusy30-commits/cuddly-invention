<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/app_toolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_app_toolbar"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/view_mode_toggle"
            style="@style/ThemeButton"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/view_mode_switch_to_paged"
            android:src="@drawable/ic_grid_view" />

        <ImageButton
            android:id="@+id/theme_toggle"
            style="@style/ThemeButton"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/theme_switch_to_dark"
            android:src="@drawable/ic_moon" />

        <ImageButton
            android:id="@+id/background_button"
            style="@style/ThemeButton"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/minimize_to_floating_bubble"
            android:src="@drawable/ic_minimize" />

        <ImageButton
            android:id="@+id/energy_saver_toggle"
            style="@style/ThemeButton"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/energy_saver_enable"
            android:src="@drawable/ic_battery_saver" />

        <ImageButton
            android:id="@+id/contact_button"
            style="@style/ThemeButton"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/contact_button_description"
            android:src="@drawable/ic_contact_support"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pager_switch_strip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                  android:id="@+id/pager_previous"
                  android:layout_width="30dp"
                  android:layout_height="30dp"
                  android:layout_marginStart="2dp"
                  android:layout_marginEnd="2dp"
                  android:background="@drawable/bg_icon_button"
                  android:clickable="true"
                  android:contentDescription="@string/pager_previous"
                  android:focusable="true"
                  android:padding="5dp"
                  android:scaleType="centerInside"
                  android:src="@drawable/ic_chevron_left"
                  android:tint="@color/text_primary" />

            <TextView
                android:id="@+id/pager_dot_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pane_badge"
                android:clickable="true"
                android:contentDescription="@string/pager_switch_to_instance_1"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pager_dot_2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pane_badge"
                android:clickable="true"
                android:contentDescription="@string/pager_switch_to_instance_2"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pager_dot_3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pane_badge"
                android:clickable="true"
                android:contentDescription="@string/pager_switch_to_instance_3"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pager_dot_4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pane_badge"
                android:clickable="true"
                android:contentDescription="@string/pager_switch_to_instance_4"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                  android:id="@+id/pager_next"
                  android:layout_width="30dp"
                  android:layout_height="30dp"
                  android:layout_marginStart="2dp"
                  android:layout_marginEnd="2dp"
                  android:background="@drawable/bg_icon_button"
                  android:clickable="true"
                  android:contentDescription="@string/pager_next"
                  android:focusable="true"
                  android:padding="5dp"
                  android:scaleType="centerInside"
                  android:src="@drawable/ic_chevron_right"
                  android:tint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/access_time_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grid_background"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Acesso válido por mais 14 dias" />

    <FrameLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/grid_background"
        android:padding="4dp">

        <com.example.quadbrowser.EqualPaneGridLayout
            android:id="@+id/browser_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grid_background"
            android:clipChildren="true"
            android:clipToPadding="true">

        <LinearLayout
            android:id="@+id/pane_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pane_card"
            android:elevation="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pane_toolbar_1"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/bg_pane_toolbar"
                android:orientation="vertical"
                android:paddingStart="5dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:id="@+id/pane_drag_handle_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PaneBadge"
                        android:id="@+id/avatar_1"
                        android:text="01" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pane_title_1"
                            style="@style/PaneTitle"
                            android:text="@string/ready_to_browse" />

                        <TextView
                            android:id="@+id/pane_subtitle_1"
                            style="@style/PaneSubtitle"
                            android:text="Instância 1 • em execução" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/navigate_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/navigate"
                        android:src="@drawable/ic_navigate" />

                    <ImageButton
                        android:id="@+id/reload_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/reload"
                        android:src="@drawable/ic_refresh" />

                    <ImageButton
                        android:id="@+id/fullscreen_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/fullscreen_enter"
                        android:src="@drawable/ic_expand" />

                    <ImageButton
                        android:id="@+id/auto_click_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/open_auto_clicker"
                        android:src="@drawable/ic_auto_click" />

                    <ImageButton
                        android:id="@+id/close_1"
                        style="@style/DangerIconButton"
                        android:contentDescription="@string/close_instance"
                        android:src="@drawable/ic_close" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
                    android:id="@+id/webview_1"
                    style="@style/BrowserWebView"
                    android:contentDescription="@string/webview_description_1" />

                <LinearLayout
                    android:id="@+id/empty_state_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pane_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/EmptyTitle"
                        android:text="@string/instance_paused" />

                    <TextView
                        style="@style/EmptyDetail"
                        android:text="@string/instance_closed_detail" />

                    <Button
                        android:id="@+id/reopen_1"
                        style="@style/ReopenButton"
                        android:text="@string/reopen_instance" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
