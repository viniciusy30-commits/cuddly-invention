                <ImageButton
                    android:id="@+id/reload_2"
                    style="@style/IconButton"
                    android:contentDescription="@string/reload"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/fullscreen_2"
                    style="@style/IconButton"
                    android:contentDescription="@string/fullscreen_enter"
                    android:src="@drawable/ic_expand" />

                <ImageButton
                    android:id="@+id/close_2"
                    style="@style/DangerIconButton"
                    android:contentDescription="@string/close_instance"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
                    android:id="@+id/webview_2"
                    style="@style/BrowserWebView"
                    android:contentDescription="@string/webview_description_2" />

                <LinearLayout
                    android:id="@+id/empty_state_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pane_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/EmptyTitle"
                        android:text="@string/instance_closed" />

                    <TextView
                        style="@style/EmptyDetail"
                        android:text="@string/instance_closed_detail" />

                    <Button
                        android:id="@+id/reopen_2"
                        style="@style/ReopenButton"
                        android:text="@string/reopen_instance" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/pane_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pane_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pane_toolbar_3"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_pane_toolbar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/PaneBadge"
                    android:text="03" />

                <EditText
                    android:id="@+id/address_3"
                    style="@style/AddressBar"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/go_3"
                    style="@style/ActionButton"
                    android:text="@string/go" />

                <ImageButton
                    android:id="@+id/reload_3"
                    style="@style/IconButton"
                    android:contentDescription="@string/reload"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/fullscreen_3"
                    style="@style/IconButton"
                    android:contentDescription="@string/fullscreen_enter"
                    android:src="@drawable/ic_expand" />

                <ImageButton
                    android:id="@+id/close_3"
                    style="@style/DangerIconButton"
                    android:contentDescription="@string/close_instance"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
                    android:id="@+id/webview_3"
                    style="@style/BrowserWebView"
                    android:contentDescription="@string/webview_description_3" />

                <LinearLayout
                    android:id="@+id/empty_state_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pane_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/EmptyTitle"
                        android:text="@string/instance_closed" />

                    <TextView
                        style="@style/EmptyDetail"
                        android:text="@string/instance_closed_detail" />

                    <Button
                        android:id="@+id/reopen_3"
                        style="@style/ReopenButton"
                        android:text="@string/reopen_instance" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/pane_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pane_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pane_toolbar_4"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_pane_toolbar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/PaneBadge"
                    android:text="04" />

                <EditText
                    android:id="@+id/address_4"
                    style="@style/AddressBar"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/go_4"
                    style="@style/ActionButton"
                    android:text="@string/go" />

                <ImageButton
                    android:id="@+id/reload_4"
                    style="@style/IconButton"
                    android:contentDescription="@string/reload"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/fullscreen_4"
                    style="@style/IconButton"
                    android:contentDescription="@string/fullscreen_enter"
                    android:src="@drawable/ic_expand" />

                <ImageButton
                    android:id="@+id/close_4"
                    style="@style/DangerIconButton"
                    android:contentDescription="@string/close_instance"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
                    android:id="@+id/webview_4"
                    style="@style/BrowserWebView"
                    android:contentDescription="@string/webview_description_4" />

                <LinearLayout
                    android:id="@+id/empty_state_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pane_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/EmptyTitle"
                        android:text="@string/instance_closed" />

                    <TextView
                        style="@style/EmptyDetail"
                        android:text="@string/instance_closed_detail" />

                    <Button
                        android:id="@+id/reopen_4"
                        style="@style/ReopenButton"
                        android:text="@string/reopen_instance" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        </GridLayout>

        <FrameLayout
            android:id="@+id/fullscreen_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pane_background"
            android:elevation="8dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/fullscreen_exit_overlay"
            style="@style/FullscreenOverlayExit"
            android:layout_gravity="top|end"
            android:contentDescription="@string/fullscreen_exit"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

        <TextView
            android:id="@+id/profile_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pane_background"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/multi_profile_unavailable"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>