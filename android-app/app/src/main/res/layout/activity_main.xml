<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <GridLayout
        android:id="@+id/browser_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grid_background"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="false">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="1dp"
        android:background="@color/pane_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="3dp">

            <EditText
                android:id="@+id/address_1"
                style="@style/AddressBar"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/go_1"
                style="@style/ToolbarButton"
                android:text="@string/go" />

            <Button
                android:id="@+id/reload_1"
                style="@style/ToolbarButton"
                android:contentDescription="@string/reload"
                android:text="@string/reload_symbol" />
        </LinearLayout>

        <WebView
            android:id="@+id/webview_1"
            style="@style/BrowserWebView"
            android:contentDescription="@string/webview_description_1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="1dp"
        android:background="@color/pane_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="3dp">

            <EditText
                android:id="@+id/address_2"
                style="@style/AddressBar"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/go_2"
                style="@style/ToolbarButton"
                android:text="@string/go" />

            <Button
                android:id="@+id/reload_2"
                style="@style/ToolbarButton"
                android:contentDescription="@string/reload"
                android:text="@string/reload_symbol" />
        </LinearLayout>

        <WebView
            android:id="@+id/webview_2"
            style="@style/BrowserWebView"
            android:contentDescription="@string/webview_description_2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="1dp"
        android:background="@color/pane_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="3dp">

            <EditText
                android:id="@+id/address_3"
                style="@style/AddressBar"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/go_3"
                style="@style/ToolbarButton"
                android:text="@string/go" />

            <Button
                android:id="@+id/reload_3"
                style="@style/ToolbarButton"
                android:contentDescription="@string/reload"
                android:text="@string/reload_symbol" />
        </LinearLayout>

        <WebView
            android:id="@+id/webview_3"
            style="@style/BrowserWebView"
            android:contentDescription="@string/webview_description_3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="1dp"
        android:background="@color/pane_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="3dp">

            <EditText
                android:id="@+id/address_4"
                style="@style/AddressBar"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/go_4"
                style="@style/ToolbarButton"
                android:text="@string/go" />

            <Button
                android:id="@+id/reload_4"
                style="@style/ToolbarButton"
                android:contentDescription="@string/reload"
                android:text="@string/reload_symbol" />
        </LinearLayout>

        <WebView
            android:id="@+id/webview_4"
            style="@style/BrowserWebView"
            android:contentDescription="@string/webview_description_4" />
    </LinearLayout>

    </GridLayout>

    <TextView
        android:id="@+id/profile_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pane_background"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/multi_profile_unavailable"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>