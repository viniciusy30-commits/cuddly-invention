<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/app_toolbar"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_app_toolbar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_title"
                style="@style/AppTitle"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/app_subtitle"
                style="@style/AppSubtitle"
                android:layout_marginTop="3dp"
                android:text="@string/app_subtitle" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/theme_toggle"
            style="@style/ThemeButton"
            android:contentDescription="@string/theme_switch_to_dark"
            android:src="@drawable/ic_moon" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/grid_background"
        android:padding="5dp">

        <GridLayout
            android:id="@+id/browser_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grid_background"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

        <LinearLayout
            android:id="@+id/pane_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="7dp"
            android:background="@drawable/bg_pane_card"
            android:elevation="4dp"
            android:orientation="vertical">">

            <LinearLayout
                android:id="@+id/pane_toolbar_1"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:background="@drawable/bg_pane_toolbar"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PaneBadge"
                        android:text="01" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pane_title_1"
                            style="@style/PaneTitle"
                            android:text="@string/ready_to_browse"
                            android:text="Pronto para navegar" />

                        <TextView
                            android:id="@+id/pane_subtitle_1"
                            style="@style/PaneSubtitle"
                            android:text="@string/instance_active_1" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/navigate_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/navigate"
                        android:src="@drawable/ic_navigate" />

                    <ImageButton
                        android:id="@+id/reload_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/reload"
                        android:src="@drawable/ic_refresh" />

                    <ImageButton
                        android:id="@+id/fullscreen_1"
                        style="@style/IconButton"
                        android:contentDescription="@string/fullscreen_enter"
                        android:src="@drawable/ic_expand" />

                    <ImageButton
                        android:id="@+id/close_1"
                        style="@style/DangerIconButton"
                        android:contentDescription="@string/close_instance"
                        android:src="@drawable/ic_close" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pane_body_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/pane_background">

                <WebView
                    android:id="@+id/webview_1"
                    style="@style/BrowserWebView"
                    android:contentDescription="@string/webview_description_1" />

                <LinearLayout
                    android:id="@+id/empty_state_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pane_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/EmptyTitle"
                        android:text="@string/instance_paused" />

                    <TextView
                        style="@style/EmptyDetail"
                        android:text="@string/instance_closed_detail" />

                    <Button
                        android:id="@+id/reopen_1"
                        style="@style/ReopenButton"
                        android:text="@string/reopen_instance" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

